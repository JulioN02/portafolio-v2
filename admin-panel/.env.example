# Admin Panel — environment variables
# Copy to admin-panel/.env if you need to override defaults. Never commit real .env files.

# API base URL
# Local dev default: "/api" — Vite dev server proxies /api to the API on :3000
# (see vite.config.ts). No .env file is required for local development.
VITE_API_URL="/api"

# Production (Vercel API deployment):
# VITE_API_URL="https://portafolio-v2-api.vercel.app"