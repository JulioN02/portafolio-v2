# Root environment variables for docker-compose.yml
# Copy to .env (git-ignored) and fill in real values. Never commit the real .env.
#
# The API and frontends also ship their own .env.example files
# (api/.env.example, client-site/.env.example, recruiter-site/.env.example).

# ── PostgreSQL container ─────────────────────────────────────────────────────
POSTGRES_USER=julion
# REQUIRED (fail-fast): docker-compose refuses to start if this is missing.
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=portafolio_v2

# ── API container ────────────────────────────────────────────────────────────
# Connection string used by the API container. Host is the compose service name
# "postgres"; port 5432 is the in-network port (not the host 5434).
# REQUIRED (fail-fast).
DATABASE_URL=postgresql://julion:CHANGE_ME_strong_db_password@postgres:5432/portafolio_v2

# JWT signing secret. Generate with:  openssl rand -base64 48
# REQUIRED (fail-fast). Never reuse the placeholder.
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48

# Allowed CORS origins (comma separated). REQUIRED (fail-fast).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
