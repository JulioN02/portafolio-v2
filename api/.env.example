# Environment variables for J Soft Solutions Portafolio API
# Copy to api/.env and fill in real values. Never commit real .env files.

# Database (Supabase PostgreSQL)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
# Production/primary DB connection. Use the Transaction Pooler (port 6543) with
# ?pgbouncer=true so the API works with Prisma + serverless (Vercel).
DATABASE_URL="postgresql://postgres.project_ref:password@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL — direct / Session mode connection (port 5432) for the Prisma CLI
# (migrations, generation). REQUIRED by schema.prisma (directUrl field). Without
# it, `prisma migrate` and `prisma generate` fail against the pooler URL above.
DIRECT_URL="postgresql://postgres.project_ref:password@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# JWT Authentication
# Generate a strong secret:  openssl rand -base64 48
# NEVER reuse a placeholder in production — replace CHANGE_ME_... with the
# output of the openssl command above.
JWT_SECRET="CHANGE_ME_<openssl rand -base64 48>"
JWT_EXPIRES_IN="12h"

# Supabase Storage (image uploads)
# Get from: Supabase Dashboard → Project Settings → API
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_SERVICE_KEY="sb_secret_your_service_key"
# Public bucket name (the service defaults to "general"). MUST match the public
# bucket you created under Supabase Dashboard → Storage, otherwise uploads fail.
SUPABASE_BUCKET="general"

# Server
NODE_ENV="development"
PORT=3000

# CORS (comma separated origins in production)
CORS_ORIGIN="http://localhost:5173,http://localhost:4173,http://localhost:5174,http://localhost:5175"

# Contact anti-spam
# Cloudflare Turnstile secret key (server-side verification).
# Get it from: Cloudflare Dashboard → Turnstile → your widget → Secret Key.
# Leave EMPTY to disable Turnstile (honeypot + rate limit stay active).
TURNSTILE_SECRET_KEY=""

# Dedicated contact submission rate limit (per IP).
# Defaults: 5 submissions per 10 minutes.
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=10