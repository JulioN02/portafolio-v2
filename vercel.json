{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @jsoft/shared build && pnpm --filter @jsoft/api exec prisma generate",
  "builds": [
    {
      "src": "api/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "packages/shared/dist/**",
          "api/prisma/**"
        ],
        "esbuild": {
          "external": ["@prisma/client", "@prisma/client/*", "@jsoft/shared"]
        }
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/src/index.ts" }
  ]
}
