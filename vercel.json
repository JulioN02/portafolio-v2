{
  "version": 2,
  "installCommand": "pnpm install && chmod +x scripts/link-shared-for-vercel.sh && bash scripts/link-shared-for-vercel.sh",
  "buildCommand": "cd api && npx prisma generate",
  "builds": [
    {
      "src": "api/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "api/prisma/**"
        ],
        "esbuild": {
          "external": ["@prisma/client", "@prisma/client/*"]
        }
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/src/index.ts" }
  ]
}
