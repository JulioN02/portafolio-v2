{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "echo 'Using pre-bundled api/build/index.cjs — no build needed'",
  "functions": {
    "api/build/index.cjs": {
      "includeFiles": "api/prisma/**"
    }
  },
  "routes": [
    { "src": "/(.*)", "dest": "api/build/index.cjs" }
  ]
}
