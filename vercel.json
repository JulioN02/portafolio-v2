{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @jsoft/api exec prisma generate",
  "builds": [
    {
      "src": "api/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "api/prisma/**"
        ],
        "esbuild": {
          "external": ["@prisma/client", "@prisma/client/*"],
          "alias": {
            "@jsoft/shared": "../packages/shared/src/server.ts"
          }
        }
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/src/index.ts" }
  ]
}
